  {
    "id": "mqtt_sensor",
    "type": "mqtt in",
    "z": "iot_praktek9",
    "name": "ESP32 -> iot/sensor",
    "topic": "iot/sensor",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 170,
    "wires": [
      [
        "validate_sensor"
      ]
    ]
  },
  {
    "id": "validate_sensor",
    "type": "function",
    "z": "iot_praktek9",
    "name": "Validasi sensor -> SQLite",
    "func": "let input=msg.payload;\nif (typeof input === 'string') { try {input=JSON.parse(input);} catch (_) {return null;} }\nif (!input || typeof input !== 'object') return null;\nconst suhu=Number(input.suhu), humid=Number(input.kelembaban);\nif (!Number.isFinite(suhu) || suhu < -40 || suhu > 80 || !Number.isFinite(humid) || humid < 0 || humid > 100) {\n node.warn('Nilai sensor tidak valid, dibuang'); return null;\n}\nconst received=new Date().toISOString();\nconst timestamp=typeof input.timestamp==='string' && !isNaN(Date.parse(input.timestamp)) ? input.timestamp : received;\nmsg.sensor={suhu, kelembaban:humid, timestamp, received};\nmsg.params={$suhu:suhu,$humid:humid,$timestamp:timestamp,$received:received};\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 170,
    "wires": [
      [
        "db_write_sensor"
      ]
    ]
  },
  {
    "id": "db_write_sensor",
    "type": "sqlite",
    "z": "iot_praktek9",
    "name": "INSERT readings",
    "mydb": "sqlite_db",
    "sqlquery": "prepared",
    "sql": "INSERT INTO readings (suhu,kelembaban,timestamp,received) VALUES ($suhu,$humid,$timestamp,$received);",
    "x": 615,
    "y": 170,
    "wires": [
      [
        "process_sensor"
      ]
    ]
  },
  {
    "id": "process_sensor",
    "type": "function",
    "z": "iot_praktek9",
    "name": "Update cache + alert crossing",
    "func": "const d=msg.sensor;\nconst prev=flow.get('lastSensor');\nflow.set('lastSensor',d);\nconst threshold=Number(flow.get('threshold') ?? 30);\nconst alert=d.suhu>threshold && (!prev || prev.suhu<=threshold);\nconst wsMsg={wsEvent:{type:'sensor',data:d,threshold}};\nif (alert) {\n const item={suhu:d.suhu,threshold,timestamp:d.received,\n message:`Suhu ${d.suhu}°C melewati batas ${threshold}°C`};\n return [wsMsg,{alert:item}];\n}\nreturn [wsMsg,null];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 835,
    "y": 170,
    "wires": [
      [
        "ws_broadcast"
      ],
      [
        "prep_alert"
      ]
    ]
  },
  {
    "id": "prep_alert",
    "type": "function",
    "z": "iot_praktek9",
    "name": "Siapkan log alert",
    "func": "const a=msg.alert;\nmsg.params={$suhu:a.suhu,$threshold:a.threshold,$timestamp:a.timestamp};\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1015,
    "y": 195,
    "wires": [
      [
        "db_alert"
      ]
    ]
  },
  {
    "id": "db_alert",
