    "name": "Update status lampu",
    "func": "let p=msg.payload;\nif (typeof p==='string') {try {p=JSON.parse(p);} catch (_) {return null;}}\nif (!p || p.device!=='lamp' || !['on','off'].includes(p.state)) return null;\nflow.set('lampState',p.state);\nreturn {wsEvent:{type:'lamp',state:p.state}};\n",
