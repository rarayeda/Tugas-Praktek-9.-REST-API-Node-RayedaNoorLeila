    "name": "Simpan cache + WebSocket",
    "func": "const threshold=msg.requestedThreshold;\nflow.set('threshold',threshold);\nconst http={...msg,payload:{status:'success',threshold,message:'Batas suhu disimpan di SQLite'}};\nreturn [http,{wsEvent:{type:'threshold',threshold}}];\n",
    "outputs": 2,
