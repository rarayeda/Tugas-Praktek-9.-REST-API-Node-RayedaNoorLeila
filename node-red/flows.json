  {
    "id": "init_sql",
    "type": "function",
    "z": "iot_praktek9",
    "name": "CREATE TABLE",
    "func": "msg.topic = `CREATE TABLE IF NOT EXISTS readings (\n id INTEGER PRIMARY KEY AUTOINCREMENT, suhu REAL NOT NULL, kelembaban REAL NOT NULL,\n timestamp TEXT NOT NULL, received TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS settings (name TEXT PRIMARY KEY, value REAL NOT NULL);\nINSERT OR IGNORE INTO settings (name,value) VALUES ('threshold',30);\nCREATE TABLE IF NOT EXISTS alerts (id INTEGER PRIMARY KEY AUTOINCREMENT,\n suhu REAL NOT NULL, threshold REAL NOT NULL, timestamp TEXT NOT NULL);\nCREATE INDEX IF NOT EXISTS idx_readings_id ON readings(id);\nCREATE INDEX IF NOT EXISTS idx_alerts_id ON alerts(id);`;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 75,
    "wires": [
      [
        "db_init"
      ]
    ]
  },
  {
    "id": "db_init",
    "type": "sqlite",
    "z": "iot_praktek9",
    "name": "Create database tables",
    "mydb": "sqlite_db",
    "sqlquery": "batch",
    "sql": "",
