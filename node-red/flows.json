  {
    "id": "publish_alert",
    "type": "function",
    "z": "iot_praktek9",
    "name": "Notifikasi dashboard + MQTT",
    "func": "return [ {wsEvent:{type:'alert',data:msg.alert}},\n {topic:'iot/alert',payload:JSON.stringify(msg.alert)} ];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
