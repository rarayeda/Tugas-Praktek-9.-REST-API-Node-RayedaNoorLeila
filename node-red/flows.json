  {
    "id": "ws_auth",
    "type": "function",
    "z": "iot_praktek9",
    "name": "Auth dengan API key (WS)",
    "func": "const sid=msg._session && msg._session.id;\nif (!sid) return null;\nlet p=msg.payload;\ntry { if (typeof p==='string') p=JSON.parse(p); } catch (_) {p=null;}\nif (!p || p.type!=='auth' || typeof p.api_key!=='string' || p.api_key!==global.get('apiKey')) {\n return {payload:JSON.stringify({type:'error',message:'Autentikasi WebSocket gagal'}),_session:msg._session};\n}\nconst sessions=flow.get('wsSessions')||{};\nsessions[sid]=msg._session;\n// Hindari pertumbuhan berlebihan saat klien putus tanpa logout.\nconst keys=Object.keys(sessions);\nif (keys.length>100) keys.slice(0,keys.length-100).forEach(k=>delete sessions[k]);\nflow.set('wsSessions',sessions);\nreturn {payload:JSON.stringify({type:'authenticated',message:'WebSocket aktif'}),_session:msg._session};\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 395,
    "y": 1050,
    "wires": [
      [
        "ws_out"
      ]
    ]
  },
  {
    "id": "ws_broadcast",
    "type": "function",
    "z": "iot_praktek9",
    "name": "Broadcast ke klien terautentikasi",
    "func": "const sessions=Object.values(flow.get('wsSessions')||{});\nif (!msg.wsEvent || !sessions.length) return null;\nconst value=JSON.stringify(msg.wsEvent);\nreturn [sessions.map(s=>({payload:value,_session:s}))];\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
