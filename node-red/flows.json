    "type": "sqlite",
    "z": "iot_praktek9",
    "name": "UPDATE threshold prepared",
    "mydb": "sqlite_db",
    "sqlquery": "prepared",
    "sql": "INSERT INTO settings(name,value) VALUES ('threshold',$value) ON CONFLICT(name) DO UPDATE SET value=excluded.value;",
