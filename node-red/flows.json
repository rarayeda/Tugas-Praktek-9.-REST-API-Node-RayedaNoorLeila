    "z": "iot_praktek9",
    "name": "INSERT alerts",
    "mydb": "sqlite_db",
    "sqlquery": "prepared",
    "sql": "INSERT INTO alerts(suhu,threshold,timestamp) VALUES ($suhu,$threshold,$timestamp);",
