  {
    "id": "put_validate",
    "type": "function",
    "z": "iot_praktek9",
    "name": "Validasi rentang 0-80",
    "func": "const value=msg.payload && msg.payload.threshold;\nif (typeof value!=='number' || !Number.isFinite(value) || value<0 || value>80) {\n msg.statusCode=400;\n msg.payload={status:'error',message:'threshold harus angka 0-80 (°C)'};\n return [null,msg];\n}\nmsg.requestedThreshold=value;\nmsg.params={$value:value};\nreturn [msg,null];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
