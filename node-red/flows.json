  {
    "id": "cache_threshold",
    "type": "function",
    "z": "iot_praktek9",
    "name": "Cache threshold awal",
    "func": "const rows=msg.payload||[];\nflow.set('threshold', rows.length ? Number(rows[0].value) : 30);\nnode.status({fill:'green',shape:'dot',text:'threshold = '+flow.get('threshold')+' C'});\nreturn null;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 950,
    "y": 75,
